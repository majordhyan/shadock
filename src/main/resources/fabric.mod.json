{
	"schemaVersion": 1,
	"id": "shadock",
	"version": "${version}",
	"name": "Shadock",
	"description": "A fast, compact shader dock for Iris. Switch, organize, and import shader packs without leaving the game.",
	"authors": [
		"whynotdhyan"
	],
	"license": "MIT",
	"icon": "assets/shadock/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"dev.shadock.shadock.ShadockClient"
		]
	},
	"mixins": [
		"shadock.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"fabric-api": "*",
		"minecraft": "~26.3",
		"java": ">=25",
		"iris": ">=1.11.7 <1.11.8"
	},
	"suggests": {
		"sodium": "*"
	}
}
