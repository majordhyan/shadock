{
	"schemaVersion": 1,
	"id": "shadock",
	"version": "${version}",
	"name": "Shadock",
	"description": "Press a key, click a shader. A small dock for switching, ordering and importing Iris shader packs in-game.",
	"authors": [
		"whynotdhyan"
	],
	"contact": {
		"homepage": "https://www.curseforge.com/minecraft/mc-mods/shadock",
		"sources": "https://github.com/majordhyan/shadock",
		"issues": "https://github.com/majordhyan/shadock/issues"
	},
	"license": "MIT",
	"icon": "assets/shadock/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"dev.shadock.shadock.ShadockClient"
		]
	},
	"mixins": [
		"mixins.shadock.json"
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"fabric-api": "*",
		"minecraft": "~26.3",
		"java": ">=25",
		"iris": ">=1.11.7 <1.11.8"
	},
	"suggests": {
		"sodium": "*"
	}
}
